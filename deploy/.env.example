# Copy to .env and fill in.
POSTGRES_PASSWORD=change-me
# Public domain (Caddy gets a TLS certificate for it). Use "localhost" for local tests.
SITE_ADDRESS=localhost
APP_ENV=prod
# Set to false only for plain-HTTP local tests.
COOKIE_SECURE=true
SESSION_TTL=12h
# Host ports for Caddy. Change them if something else (Apache, IIS, XAMPP) already uses 80/443,
# e.g. HTTP_PORT=8088 → http://localhost:8088 (with SITE_ADDRESS=:80).
HTTP_PORT=80
HTTPS_PORT=443
