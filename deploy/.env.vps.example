# /opt/nova-vida/.env on the VPS. Created once by hand; the Deploy workflow only updates IMAGE_TAG.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# demo: client demo with fixed date; prod: real use (FAKE_TODAY is refused in prod).
APP_ENV=demo
FAKE_TODAY=2027-05-12
# Local port Nginx proxies to (must be free on the VPS).
APP_PORT=8088
SESSION_TTL=12h
IMAGE_TAG=latest
